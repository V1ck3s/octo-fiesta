{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Subsonic": {
    "Url": "http://localhost:4533",
    "AdminUsername": "",
    "AdminPassword": "",
    "ExplicitFilter": "All",
    "DownloadMode": "Track",
    "StorageMode": "Permanent",
    "CacheDurationHours": 1
  },
  "Library": {
    "DownloadPath": "./downloads"
  },
  "ExternalCover": {
    "IndicatorSize": 1,
    "IndicatorSaturation": 1,
    "IndicatorColor": "0"
  },
  "Deezer": {
    "Arl": "",
    "ArlFallback": ""
  },
  "Qobuz": {
    "AppId": "",
    "AppSecret": ""
  },
  "Lyrics": {
    "Enabled": true,
    "LrclibBaseUrl": "https://lrclib.net",
    "WriteLrcFile": true,
    "AllowPlainFallback": true,
    "TimeoutSeconds": 10
  }
}
